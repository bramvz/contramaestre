{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [".claude/hooks/**/*.js", "src/**/*"],
  "exclude": [
    "node_modules",
    ".claude/hooks/logs",
    ".claude/.state",
    "dist",
    "build"
  ]
}
